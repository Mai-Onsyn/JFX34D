# 内置 14 题（首次启动自动导出，可自由修改/另存）
# 两条硬规则：
#   1) 题目之间不能有状态依赖 —— 每题执行前都会复位场景，
#      引用上一题建出来的模型必然失败。要「先建后改」就写在同一句 prompt 里。
#   2) 每条题都要有能机器判定的 check —— 纯查询题用 reply contains，
#      陷阱题用 reject with（报错才算通过）。留空就只能人工打分。
{"id":1,"category":"camera","prompt":"把摄像机位置设为 (0, 0, -10, 0)。","check":"camera.pos ≈ [0,0,-10,0]","note":"基础：SET_CAMERA_POS"}
{"id":2,"category":"camera","prompt":"读取当前摄像机位置并告诉我它是什么。","check":"reply contains (0,0,-10,0)","note":"纯查询：GET_CAMERA_POS。复位后相机固定在 (0,0,-10,0)，故答案可预期"}
{"id":3,"category":"camera_bookmark","prompt":"创建一个机位，名字叫「俯视原点」，位置在 (0, 10, 0, 0)，朝向看向原点 (0, 0, 0, 0)。","check":"bookmark:俯视原点 exists; bookmark:俯视原点 pos ≈ [0,10,0,0]","note":"首选 look_at 方案"}
{"id":4,"category":"camera_bookmark","prompt":"创建两个机位：一个叫 A 位于 (2, 0, 0, 0) 看向原点，另一个叫 B 位于 (-2, 0, 0, 0) 看向原点。","check":"bookmark:A exists; bookmark:B exists; bookmark.count == 2","note":"一轮内造多个机位，验证不受相机动画影响"}
{"id":5,"category":"camera_bookmark","prompt":"创建一个机位叫「原点」，位于原点本身，朝向看向原点。","check":"reject with 不能相同","note":"陷阱任务：pos 与 look_at 相同，视线方向是零向量，**正确的行为是拒绝**。若模型硬造一个机位（比如偷偷改 look_at），本条判为不通过"}
{"id":6,"category":"model_tree","prompt":"创建一个名为 Box 的空模型，然后列出当前场景里所有的模型。","check":"reply contains Box","note":"**自带 setup**：先建再列。复位后场景是空的，所以答案是只有 Box 一个"}
{"id":7,"category":"model_tree","prompt":"创建一个名为 Box 的空模型。","check":"model:Box exists; model.count == 1","note":"CREATE_MODEL。复位后场景是空的，所以建完恰好 1 个"}
{"id":8,"category":"model_tree","prompt":"创建一个名为 Box 的空模型，然后把它改名为 Crate。","check":"model:Crate exists; model:Box absent","note":"RENAME_MODEL —— **必须自带 setup**：Box 不能依赖上一题（7）建，因为每题执行前都会复位。这句 prompt 把「建」和「改」写在一起正是为此"}
{"id":9,"category":"shape","prompt":"在原点创建一个边长为 2 的超立方体（tesseract），命名为 T1。","check":"model:T1 exists","note":"CREATE_TESSERACT"}
{"id":10,"category":"shape","prompt":"在原点创建一个边长 1 的 5-cell，命名为 P5。","check":"model:P5 exists","note":"CREATE_5CELL"}
{"id":11,"category":"transform","prompt":"把名为 T1 的模型沿 x 轴平移 5，然后读取它的变换矩阵。","check":"reply matches \\[|矩阵|matrix","note":"TRANSFORM_MODEL + GET_MODEL_MATRIX。**自带 setup**（先建后读），判据只要求回复里带出矩阵（数值格式不稳定，不做精确比对）"}
{"id":12,"category":"carve","prompt":"在原点创建一个边长 1 的超立方体叫 T1，然后读取它的几何信息（顶点数、四面体数）。","check":"reply contains 四面体","note":"CREATE_TESSERACT + GET_MODEL_INFO。**自带 setup**。具体数值随实现变化，只校验回复里确实汇报了几何信息"}
{"id":13,"category":"composite","prompt":"创建一个叫 Tower 的模型，在里面创建两个边长为 1 的超立方体 Base 和 Top，最后把 Tower 的子模型合并。","check":"model:Tower subtree_exists","note":"复合任务：多步 + 路径寻址。不能断言 Tower/Base —— 合并后子模型会被吸收，所以只校验 Tower 这棵子树非空"}
{"id":14,"category":"composite","prompt":"创建一个机位叫「正视图」，位置 (0,0,-10,0) 看向原点；然后把摄像机切到这个机位。","check":"bookmark:正视图 exists; camera.pos ≈ [0,0,-10,0]","note":"机位 + 相机跳转的复合（相机恰好也落在同一位置，两条件可同时成立）"}
